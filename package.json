    "dotenv": "^17.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "framer-motion": "^12.24.8",
    "google-auth-library": "^10.6.2",
    "node-record-lpcm16": "^1.0.1",
    "puppeteer": "^24.43.0",
    "react": "^19.2.0",
