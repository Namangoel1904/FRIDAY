# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Build Outputs ────────────────────────────────────────────────────────────
dist/
dist-ssr/
dist-electron/
electron/models/
*.cact

# ─── Environment & Secrets ────────────────────────────────────────────────────
# Never commit real credentials. Use .env.example as the committed template.
.env
*.local

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── FRIDAY Runtime Data ──────────────────────────────────────────────────────
# Memory, session state, and user data are stored outside the project directory.
# If any runtime artefacts appear locally, exclude them here.
*.friday-session
friday-memory.json

# ─── KiCad Generated Files ────────────────────────────────────────────────────
# Gerber exports and fabrication outputs — regenerable from source scripts.
*.gbr
*.drl
*.pos
gerbers/

# ─── Editor Directories ───────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS Artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
