(kicad_pcb (version 20240108) (generator pcbnew)
  (paper "A4")
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user))

  ;; Using standard DIP-8 footprint for 555 timer (simulated placement)
  (footprint "Package_DIP:DIP-8_W7.62mm" (at 50 50) (layer "F.Cu")
    (descr "Dual In-Line Package, 8 pins")
    (pad 1 thru_hole circle (at -3.81 -2.54) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
    (pad 2 thru_hole circle (at -3.81 0) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
    (pad 3 thru_hole circle (at -3.81 2.54) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
    (pad 4 thru_hole circle (at -3.81 5.08) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
    (pad 5 thru_hole circle (at 3.81 5.08) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
    (pad 6 thru_hole circle (at 3.81 2.54) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
    (pad 7 thru_hole circle (at 3.81 0) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
    (pad 8 thru_hole circle (at 3.81 -2.54) (size 1.5 1.5) (drill 0.762) (layers "*.Cu" "*.Mask"))
  )

  ;; Using standard LED footprint (simulated placement)
  (footprint "LED_THT:LED_D5.0mm" (at 70 50) (layer "F.Cu")
    (pad 1 thru_hole circle (at 0 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask"))
    (pad 2 thru_hole circle (at 5.08 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask"))
  )

  ;; Define a simple board outline
  (gr_line (start 40 40) (end 80 40) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 80 40) (end 80 60) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 80 60) (end 40 60) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 40 60) (end 40 40) (layer "Edge.Cuts") (width 0.15))
)